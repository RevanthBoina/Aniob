# Template for local secrets. Copy to .env (git-ignored) and fill in real values there.
# .env must never be tracked: scripts/ci-preflight.sh fails if it is.
OMNIROUTE_API_KEY=DEFAULT_KEY

# --- Sign in with an account (optional) -------------------------------------------------------
# Lets a user sign in with a ChatGPT account in the browser instead of typing a key. Leave
# ACCOUNT_AUTH_CLIENT_ID=UNSET and the feature stays hidden. (Do not leave a value empty: the build's
# secrets plugin turns an empty value into a BuildConfig line that does not compile. Use UNSET.) Copy this file to .env to override.
# Read docs/ACCOUNT_SIGN_IN.md first: this uses the user's own plan, and the provider may change or
# restrict it. The client id must be one you are allowed to use; the value used by the reference
# command-line client is documented there with its source.
ACCOUNT_AUTH_CLIENT_ID=UNSET
# Browser sign-in page and token service (both must be https).
ACCOUNT_AUTH_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
ACCOUNT_AUTH_TOKEN_URL=https://auth.openai.com/oauth/token
# Fixed loopback redirect the app listens on (127.0.0.1 only). The registration decides the port.
ACCOUNT_AUTH_REDIRECT_URI=http://127.0.0.1:1455/auth/callback
ACCOUNT_AUTH_SCOPES=openid profile email offline_access api.connectors.read api.connectors.invoke
# Where model requests go; "/responses" is appended.
ACCOUNT_AUTH_INFERENCE_URL=https://chatgpt.com/backend-api/codex
# Extra sign-in page parameters as a=b&c=d. Cannot override response_type, client_id, redirect_uri,
# scope, state or the PKCE fields.
ACCOUNT_AUTH_EXTRA_PARAMS=id_token_add_organizations=true&codex_cli_simplified_flow=true&originator=aniob
# Sent as the "originator" header on model requests.
ACCOUNT_AUTH_ORIGINATOR=aniob
# Value of the OpenAI-Beta header on model requests; NONE sends none. Not verified against a live
# account: the reference client has moved to another transport, so check docs/ACCOUNT_SIGN_IN.md.
ACCOUNT_AUTH_BETA_HEADER=responses=experimental
