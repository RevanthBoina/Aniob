# Template for local secrets. Copy to .env (git-ignored) and fill in real values there.
# .env must never be tracked: scripts/ci-preflight.sh fails if it is.
OMNIROUTE_API_KEY=DEFAULT_KEY

# --- Sign in with an account (optional) -------------------------------------------------------
# Lets a user sign in with a ChatGPT account in the browser instead of typing a key. The default
# dynamic_agent_client registers this install on first sign-in; UNSET behaves the same. (Do not leave a value empty: the build's
# secrets plugin turns an empty value into a BuildConfig line that does not compile. Use UNSET.) Copy this file to .env to override.
# Read docs/ACCOUNT_SIGN_IN.md first. For explicit dynamic registration, set the client id to
# dynamic_agent_client only after confirming provider permission/eligibility for this app.
# Otherwise use an authorized static registration; never borrow another app's client identity.
ACCOUNT_AUTH_CLIENT_ID=dynamic_agent_client
# Browser sign-in page and token service (both must be https).
ACCOUNT_AUTH_AUTHORIZE_URL=https://auth.openai.com/api/accounts/authorize
ACCOUNT_AUTH_TOKEN_URL=https://auth.openai.com/api/accounts/oauth/token
# Preferred loopback redirect (127.0.0.1 only). If this port is busy the app picks a free one.
ACCOUNT_AUTH_REDIRECT_URI=http://127.0.0.1:1455/auth/callback
ACCOUNT_AUTH_SCOPES=openid profile email offline_access resource.invoke chatgpt.tokens.use.direct
# Where model requests go; "/responses" is appended.
ACCOUNT_AUTH_INFERENCE_URL=https://api.openai.com/v1
# Extra sign-in page parameters as a=b&c=d. Cannot override response_type, client_id, redirect_uri,
# scope, resource, state, nonce, host identity or the PKCE fields.
ACCOUNT_AUTH_EXTRA_PARAMS=NONE
# Sent as the "originator" header on model requests.
ACCOUNT_AUTH_ORIGINATOR=aniob
# Optional profile-specific header; NONE sends none. Not validated against a live account.
ACCOUNT_AUTH_BETA_HEADER=NONE
